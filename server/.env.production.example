# Variáveis para o servidor NA NUVEM (produção). Configure no painel da hospedagem, não suba este arquivo com valores reais.
NODE_ENV=production
PORT=3000
# 32+ caracteres aleatórios. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Atrás de Render/Railway/Fly/Nginx, deixe true para o servidor ver o IP real do cliente (limites de abuso)
TRUST_PROXY=true
# Pasta com o banco SQLite e as fotos: aponte para um DISCO PERSISTENTE da hospedagem (ex.: /data)
DATA_DIR=/data

# IA (escolha um): openrouter | gemini | openai | inworld
IMAGE_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
OPENROUTER_TEXT_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_IMAGE_MODALITIES=text,image
# Busca por voz (transcrição) usa a OpenAI
OPENAI_API_KEY=

# Planos pagos sem cobrança: NUNCA em produção (o servidor se recusa a subir se estiver true)
PLANS_UNLOCK_FOR_TESTING=false

# Fotos grandes são reduzidas para este lado maior (px) antes de ir para a IA
MAX_IMAGE_SIDE=1536

# E-mail da recuperação de senha (Resend: resend.com). Sem isso o código só aparece no log do servidor.
# Cobrança: o mesmo texto secreto que você colocar no RevenueCat (Integrations → Webhooks → Authorization header)
REVENUECAT_WEBHOOK_AUTH=
# Cobrança na versão WEB pelo Stripe (o app do Android segue pela Google Play). Sem a chave, a web não cobra.
# STRIPE_SECRET_KEY: sk_test_... (teste) ou sk_live_... (produção). STRIPE_WEBHOOK_SECRET: whsec_... do endpoint /billing/stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WEB_BASE_URL=https://app.rodanovaapp.com
RESEND_API_KEY=
MAIL_FROM=Roda Nova <nao-responda@seudominio.com.br>

# Textos legais (Política de Privacidade e Termos) – preencha com seus dados
LEGAL_COMPANY=
LEGAL_CNPJ=
LEGAL_EMAIL=
