# Copie para .env e preencha
PORT=3000
JWT_SECRET=troque-por-um-segredo-longo

# mock | gemini | openai   (mock devolve a foto original, serve para testar o fluxo sem chave)
IMAGE_PROVIDER=mock

GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite

INWORLD_API_KEY=
INWORLD_IMAGE_MODEL=google-ai-studio/gemini-3.1-flash-image
INWORLD_TEXT_MODEL=google-ai-studio/gemini-3.1-flash-lite

OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
OPENROUTER_TEXT_MODEL=google/gemini-3.1-flash-lite
# Gemini: text,image | Seedream e outros só de imagem: image
OPENROUTER_IMAGE_MODALITIES=text,image

# Custo OpenAI: low (mais barato) | medium | high
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_TEXT_MODEL=gpt-4o-mini


# So para testes: libera planos pagos sem cobrar. NUNCA ligue em producao.
PLANS_UNLOCK_FOR_TESTING=false
